# Copie para `.env` na raiz e preencha valores reais. Não commite `.env` com segredos.
#
# RPC: substituir por URLs HTTPS JSON-RPC reais (domínio válido). Sem isso, live fica desligado.
# Formato típico (exemplos de forma, sem chaves reais):
#   ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/SUA_CHAVE
#   BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/SUA_CHAVE
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=SUA_CHAVE
# Teste rápido Solana (rate limit): SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Mapeamento DEX → variável: `config/dex_endpoints.yaml` e README.
# Após alterar RPCs, reinicie o Streamlit: `streamlit run scripts/dashboard.py`.

# Ethereum — `uniswap_v2` (chain_id 1)
ETHEREUM_RPC_URL=https://SEU_RPC_ETHEREUM
# BSC — `pancakeswap_v2` (chain_id 56)
BSC_RPC_URL=https://SEU_RPC_BSC
# Base — `uniswap_v3_base`, `pancakeswap_v3_base` (chain_id 8453); só necessário se tiver posições nessas entradas
BASE_RPC_URL=https://SEU_RPC_BASE
# Solana — `pancakeswap_v3_solana` (JSON-RPC)
SOLANA_RPC_URL=https://SEU_RPC_SOLANA

DEX_API_KEY=your_dex_api_key_here

GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

ENVIRONMENT=dev
LOG_LEVEL=INFO
